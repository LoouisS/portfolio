---
import { useTranslations, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang).about;
---

<section id="about">
  <div class="s-tag fu"><span></span>{t.tag}</div>
  <h2 class="s-title fu" set:html={t.title} />
  <div class="about-bento">
    <div class="gc about-main fu">
      <p>{t.p1}</p>
      <p>{t.p2}</p>
      <p>{t.p3}</p>
    </div>
    <div class="trait-card gc fu">
      <div class="s-tag"><span></span>{t.coreValues}</div>
      <div class="trait-grid">
        {t.traits.map((tr) => (
          <div class="trait-item">
            <span class="trait-icon">{tr.icon}</span>
            <div class="trait-txt">
              <h3>{tr.title}</h3>
              <p>{tr.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
