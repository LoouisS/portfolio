---
import { useTranslations, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang).experience;
---

<section id="experience">
  <div class="s-tag fu"><span></span>{t.tag}</div>
  <h2 class="s-title fu">{t.title}</h2>
  <div class="exp-list">
    {t.jobs.map((j) => (
      <div class="gc exp-card fu">
        <div class="exp-date-col">
          <div class="exp-date" set:html={j.date.replace(" — ", " —<br>")} />
          <div class="exp-dot"></div>
        </div>
        <div>
          <p class="exp-co">{j.company}</p>
          <h3 class="exp-role">{j.role}</h3>
          <p class="exp-desc">{j.desc}</p>
          <div class="ptechs">{j.techs.map((tc) => <span class="pt">{tc}</span>)}</div>
        </div>
      </div>
    ))}
  </div>
</section>
