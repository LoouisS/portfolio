---
const projects = [
  {
    main: true,
    name: "Project One",
    status: "WIP",
    desc: "Placeholder description of your flagship project — what it does and the impact it had.",
    techs: ["Spring Boot", "Angular", "Docker", "Kubernetes"],
    links: [{ label: "GitHub ↗", href: "#" }, { label: "Live Demo ↗", href: "#" }],
  },
];
---

<section id="projects">
  <div class="s-tag fu"><span></span>Work</div>
  <h2 class="s-title fu">Featured Projects</h2>
  <p class="s-desc fu">Personal and open-source work highlighting technical depth and product craft.</p>
  <div class="proj-bento">
    {projects.map((p) => (
      <div class={`gc proj-card fu${p.main ? " proj-card-main" : ""}`}>
        <div class={`proj-img${p.main ? " proj-img-main" : ""}`}>[ project screenshot ]</div>
        <div class="proj-body">
          <div class="proj-head">
            <span class="proj-name">{p.name}</span>
            <span class={`pbadge ${p.status === "Live" ? "plive" : "pwip"}`}>{p.status}</span>
          </div>
          <p class="proj-desc">{p.desc}</p>
          <div class="ptechs">{p.techs.map((t) => <span class="pt">{t}</span>)}</div>
          <div class="proj-links">
            {p.links.map((l) => <a href={l.href} class="plink">{l.label}</a>)}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
