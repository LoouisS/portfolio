---
import { useTranslations, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang).skills;
---

<section id="skills">
  <div class="s-tag fu"><span></span>{t.tag}</div>
  <h2 class="s-title fu">{t.title}</h2>
  <p class="s-desc fu">{t.desc}</p>
  <div class="skills-bento">
    {t.groups.map((g) => (
      <div class={`gc skill-cell fu${g.wide ? " skill-cell-wide" : ""}`}>
        <div class="skill-cell-title">{g.title}</div>
        <div class="skill-chips">
          {g.items.map((item) => <span class="sc">{item}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>
