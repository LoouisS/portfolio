---
import "../styles/global.css";
import { useTranslations, type Lang } from "../i18n/content";

interface Props {
  title: string;
  name: string;
  description?: string;
  lang?: Lang;
}

const {
  title,
  name,
  description = "Guille Sánchez — Full Stack Software Engineer. Angular, Spring Boot, microservices, Kubernetes/CI-CD, and data engineering.",
  lang = "en",
} = Astro.props;

const t = useTranslations(lang).nav;
const tf = useTranslations(lang).footer;
const otherLang: Lang = lang === "en" ? "es" : "en";
const isLocalized = Astro.url.pathname.startsWith(`/${lang}/`) || Astro.url.pathname === `/${lang}`;
const otherPath = Astro.url.pathname.replace(`/${lang}`, `/${otherLang}`);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.jpg", Astro.site);
---

<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#18181a" />
    <script is:inline>
      // Runs before paint: applies a stored theme choice ahead of CSS to avoid a flash. Site is dark-first by design; light is an explicit opt-in that persists once chosen.
      const storedTheme = localStorage.getItem("theme");
      if (storedTheme === "light") document.documentElement.dataset.theme = "light";
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@2.16.0/devicon.min.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@2.16.0/devicon.min.css" />
    </noscript>
  </head>
  <body>
    <nav>
      <div class="nav-logo">{name}</div>
      <ul class="nav-links">
        <li><a href="#about">{t.about}</a></li>
        <li><a href="#skills">{t.skills}</a></li>
        <li><a href="#experience">{t.experience}</a></li>
        <li><a href="#contact">{t.contact}</a></li>
      </ul>
      <div class="nav-right">
        {isLocalized && (
          <a href={otherPath} class="icon-btn" aria-label={otherLang === "es" ? "Cambiar a Español" : "Switch to English"}>{otherLang.toUpperCase()}</a>
        )}
        <button class="icon-btn" id="themeBtn" aria-label={t.themeToLight} aria-pressed="false" data-to-light={t.themeToLight} data-to-dark={t.themeToDark}>☀</button>
        <a href="#" class="nav-pill">{t.resume}</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <span>© {new Date().getFullYear()} {name}</span>
      <span><a href="/privacy">{tf.privacy}</a> · <a href="/terms">{tf.terms}</a></span>
      <span>{tf.setIn}</span>
    </footer>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduceMotion) {
        // Reveal happens, but as a quick opacity fade with no spatial travel and no re-hide on scroll back.
        gsap.set(".fu", { opacity: 0 });
        gsap.to(".bento-hero .fu", { opacity: 1, duration: 0.3, stagger: 0.05 });
        ScrollTrigger.batch(".fu:not(.bento-hero .fu)", {
          start: "top 95%",
          onEnter: (els) => gsap.to(els, { opacity: 1, duration: 0.25, stagger: 0.04 }),
        });
      } else {
        gsap.set(".fu", { opacity: 0, y: 24 });

        gsap.to(".bento-hero .fu", {
          opacity: 1, y: 0, duration: 0.7, ease: "power2.out", stagger: 0.12, delay: 0.1,
        });

        ScrollTrigger.batch(".fu:not(.bento-hero .fu)", {
          start: "top 88%",
          end: "bottom 12%",
          onEnter: (els) => gsap.to(els, { opacity: 1, y: 0, duration: 0.6, ease: "power2.out", stagger: 0.08 }),
          onLeaveBack: (els) => gsap.to(els, { opacity: 0, y: 24, duration: 0.4, ease: "power2.in", stagger: 0.05 }),
        });
      }

      let dark = document.documentElement.dataset.theme !== "light";
      const themeBtn = document.getElementById("themeBtn");
      if (themeBtn) {
        themeBtn.textContent = dark ? "☀" : "☾";
        themeBtn.setAttribute("aria-pressed", String(!dark));
      }
      themeBtn?.addEventListener("click", () => {
        dark = !dark;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        localStorage.setItem("theme", dark ? "dark" : "light");
        themeBtn.textContent = dark ? "☀" : "☾";
        themeBtn.setAttribute("aria-label", dark ? themeBtn.dataset.toLight! : themeBtn.dataset.toDark!);
        themeBtn.setAttribute("aria-pressed", String(!dark));
      });

      // --- lang switcher: remember choice so root redirect skips detection next visit ---
      document.querySelectorAll<HTMLAnchorElement>('a[href^="/en/"], a[href^="/es/"]').forEach((a) => {
        if (!a.classList.contains("icon-btn")) return;
        a.addEventListener("click", () => {
          const chosen = a.getAttribute("href")?.startsWith("/es/") ? "es" : "en";
          localStorage.setItem("lang", chosen);
        });
      });

      // --- nav active-link scroll spy ---
      const secs = document.querySelectorAll("section[id]");
      const navAs = document.querySelectorAll<HTMLAnchorElement>(".nav-links a");
      const updateNav = () => {
        let cur = navAs[0]?.getAttribute("href")?.slice(1) ?? "";
        secs.forEach((s) => {
          if (window.scrollY >= (s as HTMLElement).offsetTop - 100) cur = s.id;
        });
        navAs.forEach((a) => a.classList.toggle("active", a.getAttribute("href") === "#" + cur));
      };
      window.addEventListener("scroll", updateNav);
      updateNav();
    </script>
  </body>
</html>
