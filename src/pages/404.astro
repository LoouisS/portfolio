---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found — Guille Sanchez" name="Guille Sanchez" description="The page you're looking for doesn't exist.">
  <section style="min-height:60vh; display:flex; flex-direction:column; justify-content:center; align-items:flex-start; gap:16px;">
    <div class="s-tag"><span></span>404</div>
    <h1 class="s-title">This page doesn't exist</h1>
    <p class="h-desc">The link may be broken, or the page may have moved.</p>
    <a href="/" class="btn-grad">Back to home →</a>
  </section>
</Layout>
